{
  "name": "autr",
  "version": "0.1.0",
  "description": "Tarayıcıda internetsiz çalışan Türkçe otomatik düzeltme paketi",
  "keywords": [
    "turkish",
    "turkce",
    "autocorrect",
    "spellcheck",
    "offline",
    "browser",
    "nlp"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/pkg/src/index.js",
  "types": "./dist/pkg/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/pkg/src/index.d.ts",
      "default": "./dist/pkg/src/index.js"
    },
    "./worker": {
      "types": "./dist/pkg/src/worker.d.ts",
      "default": "./dist/pkg/src/worker.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "onnxruntime-web": "^1.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
