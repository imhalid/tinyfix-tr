{
  "name": "tinyfix-tr",
  "version": "0.1.2",
  "description": "Tarayıcıda internetsiz çalışan Türkçe otomatik düzeltme paketi",
  "keywords": [
    "turkish",
    "turkce",
    "autocorrect",
    "spellcheck",
    "offline",
    "browser",
    "nlp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imhalid/tinyfix-tr.git",
    "directory": "pkg"
  },
  "homepage": "https://github.com/imhalid/tinyfix-tr#readme",
  "bugs": {
    "url": "https://github.com/imhalid/tinyfix-tr/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/pkg/src/index.js",
  "types": "./dist/pkg/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/pkg/src/index.d.ts",
      "default": "./dist/pkg/src/index.js"
    },
    "./worker": {
      "types": "./dist/pkg/src/worker.d.ts",
      "default": "./dist/pkg/src/worker.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "onnxruntime-web": "^1.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
